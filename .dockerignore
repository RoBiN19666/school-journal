# Что не нужно копировать в образ приложения.
# Секреты, базы, чужие загруженные файлы и служебные каталоги в контейнер
# попадать не должны: они либо создаются при работе, либо лежат на машине.

# --- Секреты ------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# --- Данные, загрузки, собранная статика -------------------------------------
media/
staticfiles/
*.sqlite3
*.sqlite3-journal
db.sqlite3
db_demo.sqlite3
*.json.enc
backup*.json

# --- Python -------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.pylibs/
.pylibs_check/
.pylibs_fix/

# --- Репозиторий, документация, инструменты ----------------------------------
.git/
.gitignore
.dsh/
.tmp/
vtmp/
.vtmp/
.agent-tools/
docs/
*.md
*.zip
*.tar.gz
*.tgz

# --- Логи, мусор редакторов и ОС ---------------------------------------------
*.log
logs/
.DS_Store
._*
Thumbs.db
desktop.ini
.idea/
.vscode/
