# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.venv/
venv/
.pylibs/
.pylibs_check/
.pylibs_fix/

# --- Секреты окружения --------------------------------------------------------
# Настоящие ключи и пароли остаются только на машине: в git попадают лишь
# файлы-примеры без значений.
.env
.env.*
!.env.example
!.env.sample
*.env

# --- Данные и загрузки --------------------------------------------------------
# Базы (в том числе демонстрационная), загруженные логотипы и значки,
# собранная статика — всё это создаётся при работе и в репозиторий не входит.
db.sqlite3
db_demo.sqlite3
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
media/
staticfiles/

# --- Резервные копии журнала --------------------------------------------------
# В копиях лежат хеши паролей и персональные данные.
backup*.json
*.backup.json
*backup*.json.enc
*.json.enc

# --- Логи, сертификаты, служебные файлы --------------------------------------
*.log
logs/
*.pem
*.key
*.crt
*.pid
*.swp
*.swo
*~

# --- Временные каталоги и инструменты агентов --------------------------------
.tmp/
.tmp*
vtmp/
.vtmp/
.agent-tools/
.dsh/
.i18n-tmp/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# --- Редакторы и IDE ----------------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# --- ОС -----------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Локальные переопределения compose ---------------------------------------
docker-compose.override.yml

# Резервные копии каталога переводов (создаёт make_locales)
*.po.bak
*.mo.bak
locale/en/LC_MESSAGES/*.bak

# Временные каталоги инструментов разработки
.installer-tmp/
.i18n-tmp/
.agent-tools/
