# =============================================================================
#  Электронный журнал посещаемости — настройки окружения
# =============================================================================
#  Этот файл — шаблон. Установщик (`bash install.sh` или `install.ps1`) копирует
#  его в `.env` и сам заполняет пустые секреты. Вручную: скопируйте файл в `.env`
#  и заполните SECRET_KEY и POSTGRES_PASSWORD (см. подсказки ниже).
#
#  `.env` читают docker compose и сам журнал. В git он не попадает.
#  Комментарии — только отдельными строками: всё, что стоит после `=` в строке
#  со значением, считается частью значения.
# =============================================================================


# --- Обязательные: без них журнал не запустится ------------------------------

# Режим работы: 0 — рабочий (подробные ошибки не показываются), 1 — отладка.
# В интернете всегда 0.
DEBUG=0

# Секретный ключ Django: случайная строка не короче 50 символов.
# Им подписываются сессии и токены CSRF, им же шифруется пароль SMTP.
# install.sh создаёт его сам. Вручную сгенерировать так:
#   openssl rand -base64 64 | LC_ALL=C tr -dc 'A-Za-z0-9' | cut -c1-64
#   python3 -c "import secrets;print(secrets.token_urlsafe(64))"
# Оставьте пустым — установщик заполнит. Ключ не меняйте: с новым ключом
# все пользователи выйдут из журнала.
SECRET_KEY=

# Домены журнала через запятую, без схемы http:// и без порта.
# Для локального запуска достаточно localhost и 127.0.0.1.
# Для сервера добавьте свой домен: journal.example.org
ALLOWED_HOSTS=localhost,127.0.0.1

# Дополнительные доверенные источники для форм (обычно не нужны: свои домены
# из ALLOWED_HOSTS журнал доверяет сам). Пример: https://journal.example.org
# CSRF_TRUSTED_ORIGINS=


# --- База данных PostgreSQL --------------------------------------------------

POSTGRES_DB=school_journal
POSTGRES_USER=school_journal

# Пароль PostgreSQL: случайный, не короче 16 символов.
# install.sh создаёт его сам; вручную: openssl rand -hex 24
# Порт базы наружу не открыт (см. docker-compose.yml), но пароль всё равно
# должен быть своим: база доступна другим контейнерам в этой сети.
POSTGRES_PASSWORD=

# Адрес базы. В docker-compose.yml HOST/ PORT заданы жёстко (db и 5432),
# эти переменные нужны только при запуске без Docker.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Сколько секунд держать соединение с базой открытым.
DB_CONN_MAX_AGE=60


# --- Основное -----------------------------------------------------------------

# Язык интерфейса по умолчанию: ru или en.
DJANGO_LANGUAGE_CODE=ru

# Часовой пояс журнала (база IANA). Время занятий и отметок считается в нём.
TIME_ZONE=Europe/Moscow

# 1 — хранить даты с часовым поясом (так рекомендует Django), 0 — без пояса.
USE_TZ=1

# Демонстрационный режим: 1 — вход без пароля как методист и преподаватель
# на отдельной демо-базе (рабочие данные не затрагиваются), 0 — выключен.
# Перед реальной работой — 0.
DEMO_MODE=0

# Имя отдельной демонстрационной базы (в рабочую базу демо-данные не попадают).
DEMO_DB_NAME=school_journal_demo

# Название организации: показывается на странице входа и в подвале.
# FUND_NAME=Образовательная организация

# Адрес админки Django. Нестандартный путь прячет её от сканеров.
ADMIN_URL=admin/

# Сколько живёт сессия без галочки «Сохранить вход», секунд (по умолчанию 12 часов).
SESSION_COOKIE_AGE=43200

# Сколько дней живёт сессия с галочкой «Сохранить вход» (журнал принимает 1–90).
REMEMBER_ME_DAYS=30

# Уровень записей в логах: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Адрес отправителя писем-уведомлений.
DEFAULT_FROM_EMAIL=journal@localhost


# --- Оформление ---------------------------------------------------------------

# Стили Tailwind лежат в проекте (journal/static/journal/vendor/tailwind.js),
# поэтому интернет для интерфейса не нужен. 1 — брать их с CDN.
TAILWIND_CDN=0


# --- Безопасность -------------------------------------------------------------
# Всё, что относится к HTTPS, включайте только когда журнал открыт по https:
# с этими флагами локальный http перестанет работать.

# 1 — доверять заголовкам X-Forwarded-* от nginx или другого прокси.
TRUST_PROXY_HEADERS=0

# 1 — перенаправлять http на https.
SECURE_SSL_REDIRECT=0

# Cookie сессии и CSRF только по https (по умолчанию включаются вместе с редиректом).
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1

# HSTS, секунд (по умолчанию год, если включён редирект на https).
# SECURE_HSTS_SECONDS=31536000

# Ограничения на загрузку файла резервной копии и число полей формы.
DATA_UPLOAD_MAX_MEMORY_SIZE=8388608
DATA_UPLOAD_MAX_NUMBER_FIELDS=5000

# Авто-блокировка адресов, которые сканируют чужие пути (/.env, /wp-admin, …).
AUTO_BLOCK_PROBES=1
AUTO_BLOCK_THRESHOLD=5
AUTO_BLOCK_WINDOW_MINUTES=15
AUTO_BLOCK_HOURS=24
# 1 — блокировать и локальные/частные адреса (по умолчанию нет, чтобы не запереть себя).
AUTO_BLOCK_PRIVATE=0

# Транспорт писем-уведомлений: SMTP или console (писать письма в лог).
NOTIFY_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# 0 — показывать встроенную отладочную страницу 404 вместо своей.
NICE_ERRORS_IN_DEBUG=1


# --- Запуск без Docker (для отладки) -----------------------------------------
# DB_ENGINE=sqlite
# DB_SQLITE_NAME=db.sqlite3
# DEMO_SQLITE_NAME=db_demo.sqlite3


# --- Docker -------------------------------------------------------------------

# Порт, по которому журнал открывается на машине: http://localhost:8000
WEB_PORT=8000

# Базовые образы. Если сборка падает с "TLS handshake timeout" на
# registry-1.docker.io, укажите зеркало Docker Hub, например:
#   PYTHON_IMAGE=dockerhub.timeweb.cloud/library/python:3.12-slim
#   POSTGRES_IMAGE=dockerhub.timeweb.cloud/library/postgres:16-alpine
PYTHON_IMAGE=python:3.12-slim
POSTGRES_IMAGE=postgres:16-alpine
